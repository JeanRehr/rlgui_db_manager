{
    "version": "2.0.0",
    "tasks": [
        /*** OS-SPECIFIC compile_commands.json GENERATOR ***/
        {
            "label": "generate compile_commands.json",
            "type": "shell",
            "command": "bear",
            "args": ["--", "make", "debug"],
            "problemMatcher": [],
            "detail": "Generates compile_commands.json",
            "linux": {
                "command": "bear",
                "args": ["--", "make", "debug"]
            },
            "windows": {
                "command": "compiledb",
                "args": ["make", "debug"]
            }
        },

        /*** CHAIN DEBUG BUILD WITH compile_commands.json ***/
        {
            "label": "make debug",
            "type": "shell",
            "command": "make",
            "args": ["debug"],
            "dependsOn": ["generate compile_commands.json"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds the debug version using make"
        },
        {
            "label": "make release",
            "type": "shell",
            "command": "make",
            "args": ["release"],
            "problemMatcher": ["$gcc"],
            "detail": "Builds the release version using make"
        },
        {
            "label": "make clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": [],
            "detail": "Cleans build artifacts"
        }
    ]
}