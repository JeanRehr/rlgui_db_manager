{
    "version": "2.0.0",
    "tasks": [
        /*** OS-SPECIFIC compile_commands.json GENERATOR ***/
        {
            "label": "generate compile_commands.json",
            "type": "shell",
            "command": "bear",
            "args": ["--", "make", "debug"],
            "problemMatcher": [],
            "detail": "Generates compile_commands.json for clangd server (bear on linux compiledb on windows",
            "linux": {
                "command": "bear",
                "args": ["--", "make", "debug"]
            },
            "windows": {
                "command": "compiledb",
                "args": ["make", "debug"]
            }
        },

        /*** CHAIN DEBUG BUILD WITH compile_commands.json ***/
        {
            "label": "make debug",
            "type": "shell",
            "command": "make",
            "args": ["debug"],
            "dependsOn": ["generate compile_commands.json"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds the debug version with symbols"
        },
        {
            "label": "make release",
            "type": "shell",
            "command": "make",
            "args": ["release"],
            "problemMatcher": ["$gcc"],
            "detail": "Builds optimized release version"
        },
        {
            "label": "make san",
            "type": "shell",
            "command": "make",
            "args": ["san"],
            "problemMatcher": ["$gcc"],
            "detail": "Builds with sanitizers (not to be used with debuggers)"
        },
        {
            "label": "clean and debug",
            "type": "shell",
            "command": "make",
            "args": ["clean", "debug"],
            "dependsOn": ["generate compile_commands.json"],
            "problemMatcher": ["$gcc"],
            "detail": "Full clean before debug build"
        },
        {
            "label": "clean and san",
            "type": "shell",
            "command": "make",
            "args": ["clean", "san"],
            "problemMatcher": ["$gcc"],
            "detail": "Full clean before sanitizer build"
        }
    ]
}